---
import PageLayout from '../layouts/PageLayout.astro';
import PlaceholderBanner from '../components/PlaceholderBanner.astro';
import { SITE } from '../config/site';

const formIsPlaceholder = SITE.formspreeEndpoint.includes('PLACEHOLDER');
---

<PageLayout
  title="Contact"
  kicker="Get in touch"
  description="Questions, corrections or balcony horror stories? Send Josh a message — every one gets read."
>
  {formIsPlaceholder && (
    <PlaceholderBanner>
      The form isn&rsquo;t connected yet. Create a form at formspree.io and replace PLACEHOLDER_FORM_ID in src/config/site.ts.
      The email address below is also a placeholder.
    </PlaceholderBanner>
  )}

  <p>
    Got a question about a setup, spotted a mistake, or want to tell me about your own balcony? Send a message below, or
    email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>

  <form class="form" id="contact-form" action={SITE.formspreeEndpoint} method="POST">
    <label>
      Your name
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      Email address
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      Message
      <textarea name="message" required></textarea>
    </label>
    <!-- Honeypot: real people never see or fill this -->
    <label class="hp" aria-hidden="true">
      Leave this empty
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="_subject" value="New message from potandbalcony.com" />
    <div>
      <button class="btn" type="submit">Send message <span class="arrow" aria-hidden="true">&rarr;</span></button>
    </div>
    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
  </form>
</PageLayout>

<script>
  // Progressive enhancement: submit in place and show a message. Without JS the form posts to Formspree normally.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        status.textContent = 'Thanks — message sent. I’ll get back to you soon.';
      } else {
        status.textContent = 'Something went wrong. Please try again or email me directly.';
      }
    } catch {
      status.textContent = 'Network error. Please try again or email me directly.';
    }
  });
</script>
